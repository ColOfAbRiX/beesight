#!/bin/bash
# Unified launcher for WSL 1, WSL 2, and standard Linux.
# WSL 1 kernel can't directly exec GraalVM native-image binaries (graal#1241),
# so we invoke via the dynamic linker on WSL 1 and directly elsewhere.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BINARY="$SCRIPT_DIR/beesight.bin"

if [ ! -f "$BINARY" ]; then
  echo "Error: Native image not found at $BINARY" >&2
  echo "Run ./build-native.sh first to build the native image." >&2
  exit 1
fi

# Detect WSL 1: Microsoft kernel with major version < 5
if grep -qi microsoft /proc/version 2>/dev/null && [ "$(uname -r | cut -d. -f1)" -lt 5 ]; then
  exec /lib64/ld-linux-x86-64.so.2 "$BINARY" "$@"
else
  exec "$BINARY" "$@"
fi
